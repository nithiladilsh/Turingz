# Normalize line endings: store LF in the repo, use LF on checkout everywhere.
# This stops the "LF will be replaced by CRLF" churn across Windows/Linux.
* text=auto eol=lf

# Binary files — never apply any line-ending conversion.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.docx  binary
*.pptx  binary
*.xlsx  binary
*.pt    binary
*.pth   binary
*.npz   binary
*.npy   binary
*.pkl   binary
